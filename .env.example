# Copy to .env and fill in your keys. The service auto-loads .env on startup
# (existing shell env vars always win). Never commit .env — it's in .gitignore.

# --- Alpaca (paper-trading keys; free) ---
ALPACA_API_KEY=PK_replace_me
ALPACA_API_SECRET=replace_me

# --- Data source ---
HFT_SOURCE=alpaca            # synthetic | csv | alpaca
ALPACA_FEED=crypto           # crypto | iex | sip
HFT_SYMBOLS=BTC/USD,ETH/USD  # for crypto use slash format

# --- Persistence ---
HFT_DB_PATH=./qpulse_live.db
HFT_CONFIG_PATH=./qpulse_live.json

# --- Optional ---
# HFT_API_TOKEN=paste_a_random_token_to_lock_down_the_api
# HFT_WEBHOOK_URL=https://webhook.site/your-uuid
# HFT_WEBHOOK_MIN_SCORE=6.0
# HFT_RECORD_TO=./recordings/$(date +%Y%m%d).csv

# --- Detector tuning (usually comes from configs/<profile>.env instead) ---
# HFT_Z_THRESH=4.0
# HFT_CUSUM_H=5.0
