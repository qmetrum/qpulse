# Detector tuning for Alpaca crypto WebSocket (24/7).
# Tuned after 69-min live run on 2026-04-23 BTC/USD+ETH/USD:
#   - obi_extreme was firing on one-sided quote artifacts → now ignored at source
#   - quote_rate_spike median score was ~8.6 with threshold 5.0 → raised to 7.0
#   - spread_widen was capturing real events (9:58 UTC cross-symbol move) → kept
HFT_Z_THRESH=4.0
HFT_CUSUM_H=5.0
HFT_CUSUM_K=0.5
HFT_ALPHA=0.02
HFT_SESSION_GAP_SEC=600
# Crypto live WS is ~10 q/sec → 100 ticks ≈ 10s warmup before scoring.
# Long enough for EWMA-MAD to stabilize and quote-rate baseline to converge.
HFT_WARMUP_TICKS=100
# Lifetime gate: don't score until each detector has absorbed ≥200 obs.
# Belt-and-braces with warmup_ticks — ensures P² markers and EWMA both
# converge before any z-score-based alert can fire.
HFT_MIN_OBS=200

HFT_SPREAD_Z_THRESH=5.0
# OBI has a longer characteristic timescale than returns; alpha 0.01 =
# ~100-step half-life (vs 34 for returns at 0.02).
HFT_OBI_ALPHA=0.01
# BTC crypto books on Alpaca's free feed routinely sit at |OBI| ∈ [0.9, 1.0]
# with both sides populated — OBI 0.9 is baseline, not anomaly.
# Require a genuine near-wall (0.98) to fire, and require the book to return
# past the midpoint (< 0.5) before re-arming. This kills the flip-flop.
HFT_OBI_EXTREME_THRESH=0.98
HFT_OBI_REARM_THRESH=0.5
HFT_QRATE_Z_THRESH=7.0
HFT_QRATE_COOLDOWN_SEC=1.0

# Phase 0.4 — Alpaca free crypto feed is quote-only (trades extremely rare).
# Feed the quote midprice into the trade-based detectors (cusum, robust_z,
# regime_shift) so half the detector palette isn't silent.
HFT_USE_QUOTE_MID=true
