# PLACEHOLDER — detector tuning for sub-second tick data.
# NOT validated. Microstructure noise (bid-ask bounce, quote flicker)
# behaves very differently from minute bars — re-tune before use:
#   python -m app.sweep --input your_ticks.csv
#
# Initial guesses only:
#   alpha lower  → longer baseline memory (ticks are noisier short-term)
#   warmup higher → more ticks to settle after a gap
#   session gap tighter → halts/lunch breaks often ~5min
HFT_Z_THRESH=4.0
HFT_CUSUM_H=5.0
HFT_CUSUM_K=0.5
HFT_ALPHA=0.005
HFT_SESSION_GAP_SEC=300
HFT_WARMUP_TICKS=50
