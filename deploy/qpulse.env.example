# Qpulse production environment file.
# Lives at /etc/qpulse/qpulse.env on the server. Mode 0640, owned root:qpulse.
# Loaded by systemd before the python process starts.

# === Required: Alpaca paper-trading keys (free) ===
ALPACA_API_KEY=PK_replace_me
ALPACA_API_SECRET=replace_me

# === Required: API auth — generate a strong random token ===
# openssl rand -hex 32
HFT_API_TOKEN=REPLACE_WITH_RANDOM_HEX_64_CHARS

# === Data source ===
HFT_SOURCE=alpaca
ALPACA_FEED=crypto                # crypto | iex | sip
HFT_SYMBOLS=BTC/USD,ETH/USD       # match feed format

# === Optional: tuned thresholds ===
# Pulled from configs/crypto.env at deploy time. Adjust here to override.
HFT_Z_THRESH=4.0
HFT_CUSUM_H=5.0
HFT_CUSUM_K=0.5
HFT_ALPHA=0.02
HFT_SESSION_GAP_SEC=600
HFT_WARMUP_TICKS=100
HFT_MIN_OBS=200

HFT_SPREAD_Z_THRESH=5.0
HFT_OBI_ALPHA=0.01
HFT_OBI_EXTREME_THRESH=0.98
HFT_OBI_REARM_THRESH=0.5
HFT_QRATE_Z_THRESH=7.0
HFT_QRATE_COOLDOWN_SEC=1.0

# === Optional: cross-asset batch detector ===
# HFT_BATCH_ENABLED=true
# HFT_BATCH_UNIVERSE=XLK,XLF,SPY,TLT,GLD,HYG
# HFT_BATCH_Z_THRESH=3.0

# === Optional: webhook sink (Slack / email gateway / Qsight ingest) ===
# HFT_WEBHOOK_URL=https://hooks.slack.com/services/...
# HFT_WEBHOOK_MIN_SCORE=6.0
#
# To forward into Qsight, point the URL at its ingest endpoint and set the key
# to the value stored in SSM at /qsight/prod/QPULSE_INGEST_KEY. Sent as the
# X-Qpulse-Key header; see docs/QSIGHT_INTEGRATION.md.
# HFT_WEBHOOK_URL=https://qsight-api.qmetrum.io/qpulse/ingest
# HFT_WEBHOOK_KEY=REPLACE_WITH_QPULSE_INGEST_KEY
